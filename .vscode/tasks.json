{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TraceOnSnow：lint",
      "type": "process",
      "command": "npm",
      "args": ["run", "lint"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TraceOnSnow：typecheck",
      "type": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "TraceOnSnow：单元测试",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TraceOnSnow：检查（lint + types + tests）",
      "dependsOrder": "sequence",
      "dependsOn": ["TraceOnSnow：lint", "TraceOnSnow：typecheck", "TraceOnSnow：单元测试"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "TraceOnSnow：生产构建",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
