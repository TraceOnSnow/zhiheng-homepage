{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Homepage: Dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder:Homepage}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "homepage-dev",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|Next\\.js",
          "endsPattern": "Ready in|Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "personal-sites",
        "clear": true
      }
    }
  ]
}
