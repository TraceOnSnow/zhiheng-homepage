{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动个人主页",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "启动 Codex（退出时 push）",
      "type": "node-terminal",
